+/// Title of the game bundled inside this app, if launched from a standalone game bundle.
+pub static BUNDLED_TITLE: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
+/// If no movie was given on the command line, look for a single SWF in the app bundle's
+/// `Contents/Resources/game` directory and play it without the menu bar.
+fn apply_bundled_movie(opt: &mut Opt) {
+    if opt.movie_url.is_some() {
+        return;
+    }
+    let Some(game_dir) = env::current_exe()
+        .ok()
+        .and_then(|exe| exe.parent()?.parent().map(|c| c.join("Resources").join("game")))
+    else {
+        return;
+    };
+    let Some(swf) = std::fs::read_dir(&game_dir).ok().and_then(|entries| {
+        entries
+            .filter_map(|e| e.ok().map(|e| e.path()))
+            .find(|p| p.extension().is_some_and(|ext| ext.eq_ignore_ascii_case("swf")))
+    }) else {
+        return;
+    };
+    if let Ok(url) = Url::from_file_path(&swf) {
+        let title = swf
+            .file_stem()
+            .map(|s| s.to_string_lossy().into_owned())
+            .unwrap_or_default();
+        let _ = BUNDLED_TITLE.set(title);
+        opt.movie_url = Some(url);
+        opt.no_gui = true;
+    }
+}
+
